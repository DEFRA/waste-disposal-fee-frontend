# Local settings. Copy to .env (gitignored), then fill in the blanks.
# `npm run dev` loads .env. See docs/local-development.md.

# Entra ID. Until our own app registration exists, use the .NET frontend's
# registration. Run this in epr-calculator-frontend to see its values:
#   dotnet user-secrets list --project src/EPR.Calculator.Frontend
# https://login.microsoftonline.com/<AzureAd:TenantId>
ENTRA_ID_AUTHORITY=
# AzureAd:ClientId
ENTRA_ID_CLIENT_ID=
# AzureAd:ClientSecret
ENTRA_ID_CLIENT_SECRET=
# The api://... scopes from DownstreamApi:Scopes, space separated, in quotes.
# The app adds openid, profile and offline_access itself.
ENTRA_ID_API_SCOPE=

# <APP_BASE_URL>/signin-oidc must be a redirect URI on the app registration.
# The .NET frontend's registration has https://localhost:7163/signin-oidc.
# HTTPS needs a local cert, run `npm run setup:certs` once.
PORT=7163
APP_BASE_URL=https://localhost:7163

# The Calculator API, running locally from epr-calculator-api
CALCULATOR_API_BASE_URL=https://localhost:7265

# `npm run setup:api-cert` adds TRUSTSTORE_DOTNET_DEV_CERT here, so this app
# trusts the local API's .NET development certificate.

# How long a session lasts, in milliseconds. 14400000 is 4 hours, the default.
# To test what happens when a session expires, set both to 60000 (1 minute), then restart.
SESSION_CACHE_TTL=14400000
SESSION_COOKIE_TTL=14400000
